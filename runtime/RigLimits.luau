function RigLimits.get(rigName: string): RigSpec?
	return RigLimits.rigs[rigName]
end

--[[ The rig a character is built on, or nil when it is neither. ]]
function RigLimits.detect(character: Model): string?
	for rigName, spec in RigLimits.rigs do
		local complete = true
		for _, part in spec.parts do
			if character:FindFirstChild(part) == nil then
				complete = false
				break
			end
		end
		if complete then
			return rigName
		end
	end
	return nil
end

return RigLimits
