--!strict
-- Generated by `python -m linen.export.luau`. Do not edit by hand.
--
-- What each gait cycle covers on the ground. `speed` is how fast the animation
-- naturally carries the character at its authored rate, so the runtime plays it
-- at `groundSpeed / speed` and the feet stop skating.
--
-- These are derived from the pose book by forward kinematics on the stock R15
-- proportions, not typed in — widen a contact pose and the stride follows. An
-- avatar with different limb lengths strides differently, but the runtime
-- divides by these numbers, so a consistent scale error cancels out.


local MotionData = {}

export type Gait = {
	--[[ Studs covered by one turn of the cycle. ]]
	stride: number,
	--[[ Studs per second at the authored rate. ]]
	speed: number,
	--[[ Cycles per second the animation was authored at. ]]
	rate: number,
	steps: number,
}

MotionData.gaits = {} :: { [string]: Gait }

MotionData.gaits["run"] = {
	stride = 7.3525,
	speed = 11.7639,
	rate = 1.6,
	steps = 2,
}

MotionData.gaits["walk"] = {
	stride = 4.7306,
	speed = 4.2576,
	rate = 0.9,
	steps = 2,
}

--[[ Playback multiplier that makes a gait cover ground at
     `speed` studs per second. Clamped, because a walk played
     at six times its rate is a blur, not a fast walk — that
     is the point at which you blend to the run instead. ]]
function MotionData.playbackFor(gait: string, speed: number): number
	local entry = MotionData.gaits[gait]
	if entry == nil or entry.speed <= 0 then
		return 1
	end
	return math.clamp(speed / entry.speed, 0.35, 2.2)
end

return MotionData
