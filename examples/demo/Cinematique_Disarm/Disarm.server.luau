-- ---------------------------------------------------------------- staging --
local models: { [string]: Model? } = {}
local tracks: { AnimationTrack } = {}

for _, entry in STAGE do
	local model = workspace:FindFirstChild(entry.name)
	if model == nil or not model:IsA("Model") then
		table.insert(missing, `rig "{entry.name}" dans Workspace`)
		continue
	end
	models[entry.name] = model

	local look = entry.position
	if typeof(entry.facing) == "string" then
		local other = workspace:FindFirstChild(entry.facing)
		if other and other:IsA("Model") then
			look = other:GetPivot().Position
		end
	elseif typeof(entry.facing) == "number" then
		look = entry.position
			+ Vector3.new(math.sin(math.rad(entry.facing)), 0, -math.cos(math.rad(entry.facing)))
	end

	if look ~= entry.position then
		model:PivotTo(CFrame.lookAt(entry.position, Vector3.new(look.X, entry.position.Y, look.Z)))
	else
		model:PivotTo(CFrame.new(entry.position))
	end
end

-- ------------------------------------------------------------------ props --
local heldWelds: { [string]: WeldConstraint } = {}

local function propModel(name: string): BasePart?
	for _, prop in PROPS do
		if prop.name ~= name then
			continue
		end
		local existing = workspace:FindFirstChild("Linen_" .. name)
		if existing and existing:IsA("BasePart") then
			return existing
		end
		local source = resolve(prop.source)
		if source == nil then
			table.insert(missing, prop.source)
			return nil
		end
		local clone = source:Clone()
		local part = if clone:IsA("BasePart") then clone else clone:FindFirstChildWhichIsA("BasePart")
		if part == nil then
			table.insert(missing, `{prop.source} ne contient aucune BasePart`)
			return nil
		end
		clone.Name = "Linen_" .. name
		clone.Parent = workspace
		return part
	end
	return nil
end

local function attachProp(name: string, actorName: string)
	local part = propModel(name)
	local model = models[actorName]
	if not part or not model then
		return
	end
	for _, prop in PROPS do
		if prop.name == name then
			local hand = model:FindFirstChild(prop.attachTo)
			if hand == nil or not hand:IsA("BasePart") then
				table.insert(missing, `{actorName}.{prop.attachTo}`)
				return
			end
			part.CFrame = hand.CFrame * CFrame.new(prop.grip)
			part.Anchored = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hand
			weld.Part1 = part
			weld.Parent = part
			heldWelds[name] = weld
			return
		end
	end
end

local function releaseProp(name: string, impulse: Vector3?)
	local weld = heldWelds[name]
	if weld then
		weld:Destroy()
		heldWelds[name] = nil
	end
	local part = workspace:FindFirstChild("Linen_" .. name)
	if part and part:IsA("BasePart") then
		part.Anchored = false
		if impulse then
			-- Applied as an impulse, so the same numbers the set plan solved the
			-- trajectory from are the numbers the engine integrates.
			part:ApplyImpulse(impulse)
		end
	end
end

-- -------------------------------------------------------------------- vfx --
local function playEffect(effectName: string, atPart: string)
	local host: Instance? = if atPart ~= "" then workspace:FindFirstChild(atPart, true) else nil
	local emitter = workspace:FindFirstChild(effectName, true)
	if emitter == nil then
		table.insert(missing, `effet "{effectName}"`)
		return
	end
	if emitter:IsA("ParticleEmitter") then
		if host and host:IsA("BasePart") and emitter.Parent ~= host then
			local clone = emitter:Clone()
			clone.Parent = host
			clone:Emit(clone.Rate > 0 and math.ceil(clone.Rate) or 24)
			task.delay(3, function()
				clone:Destroy()
			end)
		else
			emitter:Emit(24)
		end
	end
end

-- ------------------------------------------------------------------ sound --
-- Two buses, so the score can duck under the effects and both can be ridden by
-- one number. This is the smallest thing that behaves like a mixer, and every
-- sound below goes through it rather than straight to Workspace.
local sfxBus = Instance.new("SoundGroup")
sfxBus.Name = "LinenSFX"
sfxBus.Volume = 1
sfxBus.Parent = SoundService

local musicBus = Instance.new("SoundGroup")
musicBus.Name = "LinenMusic"
musicBus.Volume = 1
musicBus.Parent = SoundService

-- The tremor. TremoloSoundEffect varies a bus's volume up and down; at low
-- depth it is an unsteadiness you feel rather than hear, which is what a
-- character in trouble should sound like. Depth rides the tension curve.
local tremor = Instance.new("TremoloSoundEffect")
tremor.Frequency = 5.2
tremor.Duty = 0.6
tremor.Depth = 0
tremor.Parent = musicBus

-- And the tunnel: as tension climbs, the top end comes off the world and the
-- bottom swells. It is the oldest trick there is and it works every time.
local tunnel = Instance.new("EqualizerSoundEffect")
tunnel.LowGain = 0
tunnel.MidGain = 0
tunnel.HighGain = 0
tunnel.Parent = sfxBus

local function playSound(asset: string, volume: number, at: Instance?, group: SoundGroup?)
	if asset == "" or asset == "rbxassetid://0" then
		table.insert(missing, "un identifiant audio est encore à 0")
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = asset
	sound.Volume = volume
	sound.SoundGroup = group or sfxBus
	-- Parented to a part, Roblox makes it positional on its own.
	sound.Parent = if at and at:IsA("BasePart") then at else workspace
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
end

-- ----------------------------------------------------------------- spotted --
-- Sounds Linen derived from the animation itself: impacts, footsteps, falls.
-- The intensity travelling with each one is what keeps repeated hits from
-- sounding like a stapler — one sample played at one level is the single most
-- recognisable sign of unfinished game audio.
local function playSpot(slot: string, intensity: number, partName: string, actorName: string?)
	local entry = SOUNDS[slot]
	if entry == nil or entry.asset == "" then
		return -- Nothing mapped to this slot yet; the sheet already said so.
	end

	local host: Instance? = nil
	local model = if actorName then models[actorName] else nil
	if model and partName ~= "" then
		host = model:FindFirstChild(partName)
	end
	if host == nil and partName ~= "" then
		host = workspace:FindFirstChild(partName, true)
	end

	local sound = Instance.new("Sound")
	sound.SoundId = entry.asset
	sound.Volume = entry.volume * (0.45 + 0.55 * intensity)
	-- Harder hits sit lower, and a little jitter keeps two identical frames
	-- from sounding identical.
	sound.PlaybackSpeed = 1.06 - 0.12 * intensity + (math.random() - 0.5) * 0.08
	sound.SoundGroup = if entry.category == "MUS" then musicBus else sfxBus
	sound.Parent = if host and host:IsA("BasePart") then host else workspace
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
end

-- ------------------------------------------------------------------ faces --
-- FaceControls is a 50-pose FACS rig on a dynamic head. Named expressions keep
-- a scene readable; a blocky head simply has no FaceControls and is skipped,
-- which is why this never errors.
local function setExpression(actorName: string, name: string, hold: number)
	local model = models[actorName]
	local head = model and model:FindFirstChild("Head")
	local controls = head and head:FindFirstChildOfClass("FaceControls")
	if controls == nil then
		return
	end
	local pose = EXPRESSIONS[name]
	if pose == nil then
		return
	end
	for property, value in pose do
		pcall(function()
			(controls :: any)[property] = value
		end)
	end
	if hold > 0 then
		task.delay(hold, function()
			for property in pose do
				pcall(function()
					(controls :: any)[property] = 0
				end)
			end
		end)
	end
end

-- ------------------------------------------------------------------- line --
local function showLine(actorName: string, text: string, hold: number)
	local model = models[actorName]
	local head = model and model:FindFirstChild("Head")
	if head == nil or not head:IsA("BasePart") then
		print(`[{actorName}] {text}`)
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(12, 2)
	gui.StudsOffset = Vector3.new(0, 2.5, 0)
	gui.AlwaysOnTop = true
	gui.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamMedium
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = text
	label.Parent = gui

	task.delay(hold, function()
		gui:Destroy()
	end)
end

-- ----------------------------------------------------------------- camera --
local originalCameraType = camera.CameraType
local function cutTo(shotId: string)
	for _, shot in SHOTS do
		if shot.id ~= shotId then
			continue
		end
		-- Only a PVInstance has a pivot, and FindFirstChild hands back any
		-- Instance: a shot aimed at a Folder or a Sound would crash here.
		local found = workspace:FindFirstChild(shot.lookAt, true)
		local target = if found and found:IsA("PVInstance") then found else nil
		local focus = if target then target:GetPivot().Position else Vector3.zero
		local goal = CFrame.lookAt(shot.position, focus)

		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = shot.fov
		if shot.blend > 0 then
			TweenService:Create(camera, TweenInfo.new(shot.blend, Enum.EasingStyle.Quad), {
				CFrame = goal,
			}):Play()
		else
			camera.CFrame = goal
		end

		-- A perfectly still camera reads as a screenshot, so every shot drifts.
		if shot.drift.Magnitude > 0 then
			TweenService:Create(camera, TweenInfo.new(4, Enum.EasingStyle.Linear), {
				CFrame = CFrame.lookAt(shot.position + shot.drift, focus),
			}):Play()
		end
		return
	end
end

-- ----------------------------------------------------------------- events --
local function fire(kind: string, value: string, actorName: string?)
	local parts = string.split(value, "|")
	if kind == "sound" then
		local model = if actorName then models[actorName] else nil
		playSound(parts[1] or "", 1, model and model:FindFirstChild("Head"))
	elseif kind == "spot" then
		playSpot(parts[1] or "", tonumber(parts[2]) or 1, parts[3] or "", actorName)
	elseif kind == "vfx" then
		playEffect(parts[1] or "", parts[2] or "")
	elseif kind == "face" then
		setExpression(actorName or "", parts[1] or "", tonumber(parts[2]) or 2)
	elseif kind == "line" then
		showLine(actorName or "", parts[1] or "", tonumber(parts[2]) or 2)
	elseif kind == "camera" then
		cutTo(parts[1] or "")
	elseif kind == "prop" then
		local name, action, impulse = parts[1], parts[2], parts[3]
		if action == "attach" then
			attachProp(name, actorName or "")
		else
			local vector: Vector3? = nil
			if impulse and impulse ~= "" then
				local n = string.split(impulse, ",")
				vector = Vector3.new(tonumber(n[1]) or 0, tonumber(n[2]) or 0, tonumber(n[3]) or 0)
			end
			releaseProp(name, vector)
		end
	end
end

-- ------------------------------------------------------------------- play --
for _, prop in PROPS do
	if prop.heldBy ~= nil then
		attachProp(prop.name, prop.heldBy)
	end
end

for _, entry in STAGE do
	local model = models[entry.name]
	if not model then
		continue
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if animator == nil then
		table.insert(missing, `Animator sur "{entry.name}"`)
		continue
	end

	local sequenceName = string.format("%s_%s", SCENE_NAME, entry.name)
	local sequence = folder and folder:FindFirstChild(sequenceName)
	if sequence == nil or not sequence:IsA("KeyframeSequence") then
		table.insert(missing, `KeyframeSequence "{sequenceName}"`)
		continue
	end

	local animation = Instance.new("Animation")
	animation.Name = sequenceName
	animation.AnimationId = KeyframeSequenceProvider:RegisterKeyframeSequence(sequence)

	local track = animator:LoadAnimation(animation)
	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = false

	-- The clip carries its own events. One connection per kind is enough: the
	-- marker's value says what to do.
	for _, kind in { "sound", "spot", "vfx", "face", "line", "prop", "camera" } do
		local actorName = entry.name
		track:GetMarkerReachedSignal("linen_" .. kind):Connect(function(value: string)
			fire(kind, value, actorName)
		end)
	end

	table.insert(tracks, track)
end

if #missing > 0 then
	warn(`Linen: la scène "{SCENE_NAME}" est incomplète — il manque :`)
	for _, item in missing do
		warn(`  - {item}`)
	end
	warn("Elle va jouer quand même; ce qui manque sera simplement absent.")
end

-- Every actor starts on the same frame. One track each, all begun together, is
-- the only arrangement that cannot drift over a long take.
for _, track in tracks do
	track:Play(0)
end

-- Events with no actor have no clip to ride, so they run on the director's
-- clock, started with the tracks.
task.spawn(function()
	local elapsed = 0
	local next_ = 1
	while next_ <= #DIRECTOR do
		elapsed += RunService.Heartbeat:Wait()
		while next_ <= #DIRECTOR and DIRECTOR[next_].at <= elapsed do
			local cue = DIRECTOR[next_]
			fire(cue.kind, cue.value, cue.actor)
			next_ += 1
		end
	end
end)

-- --------------------------------------------------------------- ambience --
-- The beds, and the one number they all ride. Linen sampled the scene's
-- tension while spotting it; here that curve becomes volume on the drone, depth
-- on the tremor, and the low-pass that closes in when things get bad. Nothing
-- below is authored frame by frame — it is all the same curve, read live.
local function tensionAt(seconds: number): number
	if #TENSION == 0 then
		return 0
	end
	local last = TENSION[#TENSION]
	if seconds >= last[1] then
		return last[2]
	end
	for i = 1, #TENSION - 1 do
		local a, b = TENSION[i], TENSION[i + 1]
		if seconds < b[1] then
			local span = b[1] - a[1]
			local alpha = if span > 0 then (seconds - a[1]) / span else 0
			return a[2] + (b[2] - a[2]) * alpha
		end
	end
	return last[2]
end

local beds: { { bed: any, sound: Sound } } = {}
for _, bed in AMBIENCE do
	local entry = SOUNDS[bed.slot]
	if entry == nil or entry.asset == "" then
		continue
	end
	local sound = Instance.new("Sound")
	sound.SoundId = entry.asset
	sound.Looped = true
	sound.Volume = 0
	sound.SoundGroup = if entry.category == "MUS" then musicBus else sfxBus
	sound.Parent = SoundService
	table.insert(beds, { bed = bed, sound = sound })
end

task.spawn(function()
	local elapsed = 0
	while elapsed < DURATION + 1 do
		elapsed += RunService.Heartbeat:Wait()
		local tension = tensionAt(elapsed)

		for _, held in beds do
			local bed, sound = held.bed, held.sound
			local inside = elapsed >= bed.start and elapsed <= bed.stop
			if inside and not sound.IsPlaying then
				sound:Play()
			elseif not inside and sound.IsPlaying then
				sound:Stop()
			end
			if inside then
				local entry = SOUNDS[bed.slot]
				local reach = bed.low + (bed.high - bed.low) * tension
				-- Eased rather than set, so a spike in the curve does not click.
				local target = (entry and entry.volume or 0.5) * reach
				sound.Volume += (target - sound.Volume) * 0.08
			end
		end

		tremor.Depth = math.clamp((tension - 0.35) / 0.65, 0, 1) * 0.5
		tunnel.HighGain = -18 * math.clamp((tension - 0.4) / 0.6, 0, 1)
		tunnel.LowGain = 5 * math.clamp((tension - 0.4) / 0.6, 0, 1)
	end

	for _, held in beds do
		held.sound:Stop()
		held.sound:Destroy()
	end
	sfxBus:Destroy()
	musicBus:Destroy()
end)

task.delay(DURATION + 1, function()
	camera.CameraType = originalCameraType
end)

print(string.format("Linen: %q — %d acteurs, %.2fs a %g fps, %d cues, %d evenements, %d nappes.",
	SCENE_NAME, #tracks, DURATION, FPS, #CUES, #DIRECTOR, #beds))
