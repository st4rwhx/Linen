</ProtectedString></Properties></Item><Item class="Script" referent="RBX2"><Properties><string name="Name">InstallerLinen</string><ProtectedString name="Source">--!strict
-- Generated by Linen. Run this once, in Studio, with the rig in the Workspace.
--
--   1. Drag this folder into ServerStorage (anywhere works).
--   2. Right-click the script &gt; Run Script. Or paste it in the Command Bar.
--   3. Open Moon Animator &gt; Load &gt; "Walk".
--
-- It builds a Moon Animator 2 save out of the motion in the Motion module and
-- the joints of the rig as it actually is. Nothing is uploaded and nothing
-- outside ServerStorage.MoonAnimator2Saves is touched.

local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")

-- `script.Parent` is `Instance?` to the type checker, and this script is only
-- ever run from inside the folder Linen wrote, so say so rather than index
-- through a maybe-nil.
local folder = assert(script.Parent, "Linen: lance le script depuis le dossier Linen_*")
local Motion = require(folder:WaitForChild("Motion"))

local RIG_NAME = "Dummy"

local function findRig(): Model
	local named = workspace:FindFirstChild(RIG_NAME)

	if named and named:IsA("Model") and named:FindFirstChildWhichIsA("Humanoid") then
		return named
	end

	for _, model in workspace:GetChildren() do
		if model:IsA("Model") and model:FindFirstChildWhichIsA("Humanoid") then
			return model
		end
	end

	error(
		"Linen: aucun rig dans le Workspace. Construis-en un (Avatar &gt; Rig Builder "
		.. "&gt; R15) puis relance le script."
	)
end

-- Every Motor6D, keyed by the name of the part it drives. This is the same
-- key Moon's own reader uses, which is why the hierarchy below is written in
-- part names rather than joint names.
local function motorsByPart(rig: Model): { [string]: Motor6D }
	local motors: { [string]: Motor6D } = {}

	for _, descendant in rig:GetDescendants() do
		if descendant:IsA("Motor6D") and descendant.Part1 then
			motors[(descendant.Part1 :: BasePart).Name] = descendant
		end
	end

	return motors
end

-- "LowerTorso.UpperTorso.RightUpperArm": the chain of driven parts down to
-- this one. It stops at the highest part that is itself driven by a joint,
-- because that is where Moon's reader starts walking.
local function hierarchy(motors: { [string]: Motor6D? }, part: string): string
	local chain = { part }
	local motor = motors[part]

	while motor and motor.Part0 do
		local parent = (motor.Part0 :: BasePart).Name

		if motors[parent] == nil then
			break
		end

		table.insert(chain, 1, parent)
		motor = motors[parent]
	end

	return table.concat(chain, ".")
end

local function pathOf(instance: Instance): ({ string }, { string })
	local names, classes = {}, {}
	local current: Instance? = instance

	while current do
		table.insert(names, 1, current.Name)
		table.insert(classes, 1, current.ClassName)
		current = current.Parent
	end

	return names, classes
end

local function value(class: string, name: string, parent: Instance): any
	local instance = Instance.new(class)
	instance.Name = name
	instance.Parent = parent
	return instance
end

local function folder(name: string, parent: Instance): Folder
	local instance = Instance.new("Folder")
	instance.Name = name
	instance.Parent = parent
	return instance
end

local function toCFrame(components: { any }): CFrame
	return CFrame.new(
		components[1], components[2], components[3],
		components[4], components[5], components[6],
		components[7], components[8], components[9],
		components[10], components[11], components[12]
	)
end

local rig = findRig()
local motors = motorsByPart(rig)

local saves = ServerStorage:FindFirstChild("MoonAnimator2Saves")

if not saves then
	saves = folder("MoonAnimator2Saves", ServerStorage)
end

assert(saves)

local existing = saves:FindFirstChild(Motion.Name)

if existing then
	existing:Destroy()
end

local save = Instance.new("StringValue")
save.Name = Motion.Name

local names, classes = pathOf(rig)

save.Value = HttpService:JSONEncode({
	Information = {
		Length = Motion.Length,
		Looped = Motion.Looped,
		FPS = Motion.FPS,
	},

	Items = {
		{
			Path = {
				ItemType = "Rig",
				InstanceNames = names,
				InstanceTypes = classes,
			},
		},
	},
})

-- "1" is the index of the single item declared above.
local item = folder("1", save)
local rigFolder = folder("Rig", item)

local written, skipped = 0, {}

for part, keys in Motion.Tracks do
	local motor = motors[part]

	if not motor then
		table.insert(skipped, part)
		continue
	end

	local joint = folder("_joint", rigFolder)
	local default = motor.C1

	local hier = value("StringValue", "_hier", joint)
	hier.Value = hierarchy(motors, part)

	local rest = value("CFrameValue", "default", joint)
	rest.Value = default

	local keyframes = folder("_keyframes", joint)

	for _, key in keys do
		local frame = key.frame
		local transform = toCFrame(key.cframe)

		-- Moon stores the joint's animated C1. Its reader recovers the
		-- transform as `c1:Inverse() * default`, so this is that, inverted.
		local pack = folder(tostring(frame), keyframes)
		local values = folder("Values", pack)

		local at = value("CFrameValue", "0", values)
		at.Value = default * transform:Inverse()

		local eases = folder("Eases", pack)
		local ease = folder("0", eases)
		local easeType = value("StringValue", "Type", ease)
		easeType.Value = "Linear"

		local params = folder("Params", ease)
		local direction = value("StringValue", "Direction", params)
		direction.Value = "InOut"
	end

	written += 1
end

save.Parent = saves

print(
	`Linen: "{Motion.Name}" -&gt; ServerStorage.MoonAnimator2Saves ({written} `
	.. `articulations, {Motion.Length} images a {Motion.FPS} fps). `
	.. `Ouvre Moon Animator &gt; Load.`
)

if #skipped &gt; 0 then
	warn(
		`Linen: {#skipped} parties absentes du rig et ignorees : `
		.. table.concat(skipped, ", ")
	)
end
</ProtectedString></Properties></Item></Item></roblox>