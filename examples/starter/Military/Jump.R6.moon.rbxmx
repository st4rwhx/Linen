-- Generated by Linen. The motion only: no rig, no assumptions about one.
--
-- Each key is a frame and the 12 CFrame components of the transform the
-- animation applies to that part's joint — the same thing a
-- KeyframeSequence Pose carries.
--
-- Named fields rather than {frame, components}: a mixed array infers as
-- the type of its first element, so every key in the file came back as a
-- type error under strict mode.

export type Key = { frame: number, cframe: { number } }
export type Motion = {
	Name: string,
	FPS: number,
	Length: number,
	Looped: boolean,
	Tracks: { [string]: { Key } },
}

local motion: Motion = {
	Name = "Militaire_Jump",
	FPS = 30,
	Length = 16,
	Looped = false,

	Tracks = {
		["Head"] = {
			{ frame = 0, cframe = {0, 0, 0, 0.994522, 0, 0.104528, -0.007292, 0.997564, 0.069374, -0.104274, -0.069756, 0.992099} },
			{ frame = 16, cframe = {0, 0, 0, 0.994522, 0, 0.104528, -0.007292, 0.997564, 0.069374, -0.104274, -0.069756, 0.992099} },
		},
		["Left Arm"] = {
			{ frame = 0, cframe = {0, 0, 0, 0.955555, -0.16849, 0.241922, 0.277187, 0.792951, -0.542582, -0.100413, 0.585525, 0.804412} },
			{ frame = 16, cframe = {0, 0, 0, 0.955555, -0.16849, 0.241922, 0.277187, 0.792951, -0.542582, -0.100413, 0.585525, 0.804412} },
		},
		["Left Leg"] = {
			{ frame = 0, cframe = {0, 0, 0, 0.997564, 0.069756, 0, -0.057831, 0.827018, -0.559193, -0.039007, 0.557831, 0.829038} },
			{ frame = 3, cframe = {0, 0, 0, 0.997564, 0.069756, 0, -0.057831, 0.827018, -0.559193, -0.039007, 0.557831, 0.829038} },
			{ frame = 4, cframe = {0, 0, 0, 0.995112, 0.094271, 0.029403, -0.084657, 0.967696, -0.237482, -0.05084, 0.233832, 0.970947} },
			{ frame = 5, cframe = {0, 0, 0, 0.997161, 0.074296, 0.012208, -0.075254, 0.988665, 0.129913, -0.002417, -0.130463, 0.99145} },
			{ frame = 10, cframe = {0, 0, 0, 0.997366, 0.072226, -0.006601, -0.070969, 0.990653, 0.116494, 0.014953, -0.115719, 0.993169} },
			{ frame = 11, cframe = {0, 0, 0, 0.996671, 0.077508, 0.025306, -0.079793, 0.991015, 0.107338, -0.016759, -0.109, 0.9939} },
			{ frame = 12, cframe = {0, 0, 0, 0.99468, 0.099568, 0.026422, -0.094138, 0.982722, -0.159362, -0.041833, 0.156027, 0.986867} },
			{ frame = 13, cframe = {0, 0, 0, 0.994522, 0.104528, 0, -0.09395, 0.89387, -0.438371, -0.045822, 0.43597, 0.898794} },
			{ frame = 16, cframe = {0, 0, 0, 0.994522, 0.104528, 0, -0.09395, 0.89387, -0.438371, -0.045822, 0.43597, 0.898794} },
