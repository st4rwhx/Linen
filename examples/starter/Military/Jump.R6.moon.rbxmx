			{ frame = 4, cframe = {0, 0, 0, 0.829038, 0.557831, 0.039007, -0.559193, 0.827018, 0.057831, 0, -0.069756, 0.997564} },
			{ frame = 5, cframe = {0, 0, 0, 0.999265, 0.038251, 0.002675, -0.038345, 0.99683, 0.069705, 0, -0.069756, 0.997564} },
			{ frame = 6, cframe = {0, 0, 0, 0.978148, -0.207405, -0.014503, 0.207912, 0.975765, 0.068232, 0, -0.069756, 0.997564} },
			{ frame = 10, cframe = {0, 0, 0, 0.978148, -0.207405, -0.014503, 0.207912, 0.975765, 0.068232, 0, -0.069756, 0.997564} },
			{ frame = 11, cframe = {0, 0, 0, 0.973341, 0.228352, 0.021493, -0.229354, 0.969772, 0.083304, -0.001821, -0.086012, 0.996292} },
			{ frame = 12, cframe = {0, 0, 0, 0.890346, 0.453389, 0.041505, -0.455285, 0.886597, 0.081619, 0.000207, -0.091566, 0.995799} },
			{ frame = 13, cframe = {0, 0, 0, 0.866025, 0.498143, 0.043052, -0.5, 0.862703, 0.075783, 0.000609, -0.087156, 0.996195} },
			{ frame = 16, cframe = {0, 0, 0, 0.829038, 0.557831, 0.039007, -0.559193, 0.827018, 0.057831, 0, -0.069756, 0.997564} },
