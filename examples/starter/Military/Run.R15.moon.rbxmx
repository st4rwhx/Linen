			{ frame = 0, cframe = {0, 0, 0, 0.999848, 0, 0.017452, 0.003031, 0.984808, -0.173622, -0.017187, 0.173648, 0.984658} },
			{ frame = 10, cframe = {0, 0, 0, 0.975917, 0, -0.218143, -0.03788, 0.984808, -0.169466, 0.214829, 0.173648, 0.96109} },
			{ frame = 19, cframe = {0, 0, 0, 0.999974, 0, 0.007214, 0.001253, 0.984808, -0.173644, -0.007104, 0.173648, 0.984782} },
			{ frame = 20, cframe = {0, 0, 0, 0.999994, 0, 0.003491, 0.000606, 0.984808, -0.173647, -0.003438, 0.173648, 0.984802} },
			{ frame = 29, cframe = {0, 0, 0, 0.974579, 0, -0.224044, -0.038905, 0.984808, -0.169234, 0.22064, 0.173648, 0.959773} },
			{ frame = 33, cframe = {0, 0, 0, 0.990073, 0, -0.140556, -0.024407, 0.984808, -0.171924, 0.13842, 0.173648, 0.975031} },
			{ frame = 36, cframe = {0, 0, 0, 0.999766, 0, -0.02164, -0.003758, 0.984808, -0.173608, 0.021312, 0.173648, 0.984577} },
			{ frame = 39, cframe = {0, 0, 0, 0.999848, 0, 0.017452, 0.003031, 0.984808, -0.173622, -0.017187, 0.173648, 0.984658} },
