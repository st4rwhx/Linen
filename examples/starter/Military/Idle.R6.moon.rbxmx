-- Generated by Linen. The motion only: no rig, no assumptions about one.
--
-- Each key is a frame and the 12 CFrame components of the transform the
-- animation applies to that part's joint — the same thing a
-- KeyframeSequence Pose carries.
--
-- Named fields rather than {frame, components}: a mixed array infers as
-- the type of its first element, so every key in the file came back as a
-- type error under strict mode.

export type Key = { frame: number, cframe: { number } }
export type Motion = {
	Name: string,
	FPS: number,
	Length: number,
	Looped: boolean,
	Tracks: { [string]: { Key } },
}

local motion: Motion = {
	Name = "Militaire_Idle",
	FPS = 30,
	Length = 180,
	Looped = true,

	Tracks = {
		["Head"] = {
			{ frame = 0, cframe = {0, 0, 0, 0.990268, -0.139173, 0, 0.139088, 0.989665, -0.034899, 0.004857, 0.03456, 0.999391} },
			{ frame = 54, cframe = {0, 0, 0, 0.98481, -0.173638, 0, 0.173638, 0.98481, -0.00001, 0.000002, 0.00001, 1} },
			{ frame = 90, cframe = {0, 0, 0, 0.990268, -0.139173, 0, 0.139088, 0.989665, -0.034899, 0.004857, 0.03456, 0.999391} },
			{ frame = 180, cframe = {0, 0, 0, 0.990268, -0.139173, 0, 0.139088, 0.989665, -0.034899, 0.004857, 0.03456, 0.999391} },
		},
		["Left Arm"] = {
			{ frame = 0, cframe = {0, 0, 0, 0.777677, 0.628521, -0.013431, -0.565015, 0.689415, -0.453281, -0.275637, 0.360095, 0.891266} },
			{ frame = 54, cframe = {0, 0, 0, 0.504078, 0.860279, -0.076328, -0.806484, 0.437245, -0.397995, -0.309013, 0.262178, 0.914207} },
			{ frame = 90, cframe = {0, 0, 0, 0.777677, 0.628521, -0.013431, -0.565015, 0.689415, -0.453281, -0.275637, 0.360095, 0.891266} },
			{ frame = 180, cframe = {0, 0, 0, 0.777677, 0.628521, -0.013431, -0.565015, 0.689415, -0.453281, -0.275637, 0.360095, 0.891266} },
		},
		["Left Leg"] = {
			{ frame = 0, cframe = {0, 0, 0, 0.998849, -0.047788, -0.004171, 0.047943, 0.991637, 0.119825, -0.00159, -0.119887, 0.992786} },
			{ frame = 54, cframe = {0, 0, 0, 0.999965, 0.007204, -0.004361, -0.006578, 0.991543, 0.129611, 0.005258, -0.129577, 0.991555} },
			{ frame = 90, cframe = {0, 0, 0, 0.998849, -0.047788, -0.004171, 0.047943, 0.991637, 0.119825, -0.00159, -0.119887, 0.992786} },
			{ frame = 180, cframe = {0, 0, 0, 0.998849, -0.047788, -0.004171, 0.047943, 0.991637, 0.119825, -0.00159, -0.119887, 0.992786} },
		},
		["Right Arm"] = {
			{ frame = 0, cframe = {0, 0, 0, 0.959567, -0.195713, -0.202305, 0.221534, 0.968485, 0.113844, 0.173648, -0.154058, 0.972683} },
			{ frame = 54, cframe = {0, 0, 0, 0.879184, -0.347981, -0.325493, 0.428731, 0.875799, 0.221732, 0.207908, -0.334492, 0.919179} },
			{ frame = 90, cframe = {0, 0, 0, 0.959567, -0.195713, -0.202305, 0.221534, 0.968485, 0.113844, 0.173648, -0.154058, 0.972683} },
			{ frame = 180, cframe = {0, 0, 0, 0.959567, -0.195713, -0.202305, 0.221534, 0.968485, 0.113844, 0.173648, -0.154058, 0.972683} },
